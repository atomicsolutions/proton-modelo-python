{
  "descricao": "Compra parcelada (API, web e desktop): a compra com sucesso e a parcela calculada na Calculadora do Windows.",
  "requer": ["windows"],
  "passos": [
    {
      "componente": "ConsultarCep",
      "parametros": {
        "in_cep": "01310-100"
      }
    },
    {
      "componente": "FazerLogin",
      "parametros": {
        "in_usuario": "standard_user",
        "in_senha": "${env:SENHA_DA_LOJA}"
      }
    },
    {
      "componente": "AdicionarAoCarrinho",
      "parametros": {
        "in_produto": "Sauce Labs Backpack"
      }
    },
    {
      "componente": "FinalizarCompra",
      "parametros": {
        "in_nome": "Ana",
        "in_sobrenome": "Souza",
        "in_cep": "${out_cep}",
        "in_preco_esperado": "${out_preco}"
      }
    },
    {
      "componente": "CalcularParcela",
      "parametros": {
        "in_total": "${out_total}",
        "in_parcelas": "3"
      }
    }
  ]
}
