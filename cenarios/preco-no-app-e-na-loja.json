{
  "descricao": "Preço no app e na loja (mobile e web): a mochila custa o mesmo no app e na loja web.",
  "requer": ["android"],
  "passos": [
    {
      "componente": "AdicionarAoCarrinhoNoApp",
      "parametros": {
        "in_produto": "Sauce Labs Backpack"
      }
    },
    {
      "componente": "FazerLogin",
      "parametros": {
        "in_usuario": "standard_user",
        "in_senha": "${env:SENHA_DA_LOJA}"
      }
    },
    {
      "componente": "AdicionarAoCarrinho",
      "parametros": {
        "in_produto": "Sauce Labs Backpack"
      }
    },
    {
      "componente": "FinalizarCompra",
      "parametros": {
        "in_nome": "Ana",
        "in_sobrenome": "Souza",
        "in_cep": "01310-100",
        "in_preco_esperado": "${out_preco_no_app}"
      }
    }
  ]
}
