# Copie para .env (que não vai para o git) e ajuste.

# Senha dos usuários de demonstração da loja. É pública, mas fica fora do git para
# mostrar o caminho certo: num projeto real, senha nunca vai no repositório.
SENHA_DA_LOJA=secret_sauce

# Endereço da loja.
URL_DA_LOJA=https://www.saucedemo.com

# false abre o navegador na tela, para acompanhar a automação.
HEADLESS=true

# Vazio usa o Chromium da Playwright, instalado sozinho na primeira execução. "chrome" ou
# "msedge" usam o navegador já instalado, sem download.
CANAL_DO_NAVEGADOR=

# Tempo máximo de espera de cada ação, em milissegundos.
TIMEOUT_MS=15000

# API de CEP e o tempo máximo de cada chamada, em segundos.
URL_DA_API_DE_CEP=https://viacep.com.br/ws
TIMEOUT_DA_API_S=15

# Mobile (Appium). Sem o Appium no ar no endereço local, a automação o inicia sozinha.
APPIUM_URL=http://127.0.0.1:4723
# O serial do aparelho (adb devices); vazio usa o primeiro conectado.
MOBILE_DISPOSITIVO=
# O caminho do .apk; vazio abre o app já instalado no aparelho, pelo pacote e pela activity.
MOBILE_APP=
MOBILE_PACOTE=com.saucelabs.mydemoapp.android
MOBILE_ACTIVITY=.view.activities.SplashActivity
TIMEOUT_MOBILE_S=20

# SAP (só para o cenário login-sap.json): a descrição da conexão no SAP Logon, o caminho
# do saplogon.exe e as credenciais. Sem SAP_CONEXAO, o cenário de SAP é pulado.
SAP_CONEXAO=
SAP_LOGON=C:\Program Files\SAP\FrontEnd\SAPGUI\saplogon.exe
SAP_USUARIO=
SAP_SENHA=
SAP_MANDANTE=

# Pasta das evidências (prints e respostas de API). Numa execução do Proton, o que
# aparece nela durante um passo sobe para aquele passo.
PASTA_DE_EVIDENCIAS=evidencias
